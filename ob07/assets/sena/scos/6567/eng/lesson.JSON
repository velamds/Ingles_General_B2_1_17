, {"correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn9le17ob07re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " \nFind out what jobs people do in the movie industry.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self-Assessment.\n", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "The World of Entertainment", "type": "lesson_name"}, {"content": "Directing a Movie", "type": "unit_name"}, {"content": 7, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 17, "type": "lesson"}, {"content": "B2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe situations in spoken interactions according to work and social contexts.", "type": "primary"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_1"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_2"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_3"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_4"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_5"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_6"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_7"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_8"}]}, {"content": "engenn9le17ob07re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "  Talking About the Past: The Present Perfect Tense vs. The Simple Past Tense and Used to and Would", "type": "heading"}, {"content": " You use the <span class=\"strong\">Present Perfect tense</span> to talk about a past action or an action that began in the past that is connected to the present in some way. <br/> You use the <span class=\"strong\">Simple Past tense</span> to talk about many kinds of past events: short, quickly finished actions, longer situations and repeated events. <br/> You use <span class=\"strong\">used to </span> and <span class=\"strong\">would </span> to talk about past habits which are now finished. There is an idea that circumstances have changed. You do not use it to talk about what happened at a past time. ", "type": "describer"}, {"content": "You can use the <span class=\"strong\">Present Perfect tense </span> to talk about experience.<br/> When you use the <span class=\"strong\">Present Perfect tense</span>, you think about the past and present together. There is some connection between what happened in the past and now.", "type": "text"}, {"content": "For example:<br> <span class=\"italic\">I <span class=\"strong\">have learned </span> English. </span> = I learned English in the past and now I can speak English. ", "type": "text"}, {"content": "Usually, when you use the <span class=\"strong\">Simple Past tense</span>, the time of the finished action is clear from the context or explicitly mentioned in the sentence.", "type": "text"}, {"content": "For example:<br> <span class=\"italic\"><span class=\"strong\">Yesterday</span>, I <span class=\"strong\">went </span> to the store.</span> ", "type": "text"}, {"content": "It is clear when the action occurred. In this sentence we would not use the <span class=\"strong\">Present Perfect</span>. (<span class=\"italic\"><strike>Yesterday, I have been to the store</strike></span>).", "type": "text"}, {"content": "Both <span class=\"strong\">used to </span> and <span class=\"strong\">would </span> talk about past habits which no longer exist, but there are a couple of things to note about the usage of these expressions.", "type": "text"}, {"content": "1. <span class=\"strong\">Would</span> cannot be used to talk about past states. You must use <span class=\"strong\">use to.</span> <br>For example:<span class=\"italic\">I used to have a dog.</span> <span class=\"italic\"><strike>I would have a dog. </strike> </span> ", "type": "text"}, {"content": "2. You use <span class=\"strong\">used to </span> to talk about regular, important habitual behavior. <br> For example: <span class=\"italic\">I used to smoke. <strike>I would smoke.</strike> </span> ", "type": "text"}, {"content": "I used to do too much. ", "type": "example"}, {"content": "Then I started to let everyone do what they came to do. ", "type": "example"}, {"content": "I have never looked back.", "type": "example"}, {"content": "I was very confident, and saw every problem as as a challenge to be overcome.", "type": "example"}, {"content": "This was the most important lesson I learned on my first film. ", "type": "example"}, {"content": "That knowledge has helped me ever since. ", "type": "example"}, {"content": "We have had some really complicated sets this time around.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " The Passive: The Present Continuous and Present Perfect Tenses", "type": "heading"}, {"content": "You use an active structure when you want the \u2018doer' of the action to be the subject.<br/> You use a passive structure when you want the \u2018receiver' of the action to be the subject. ", "type": "describer"}, {"content": "You use the </span> Present Continuous </span> to talk about an action that is happening at the time of speaking. The action or event is in progress. ", "type": "text"}, {"content": "<span class=\"italic\">Any director who a strong production team<span class=\"strong\"> is supporting </span> should realize that they are beyond lucky.</span> ", "type": "text"}, {"content": "You use the </span> Present Perfect </span> to talk about a finished action or event with present consequences. There is a connection between what happened in the past and the present.", "type": "text"}, {"content": "<span class=\"italic\">People on set<span class=\"strong\"> have left </span> the actors to me. </span> ", "type": "text"}, {"content": "You often choose the <span class=\"strong\">passive form </span> when you want to talk about an action but are not so interested in saying who or what does/did it. Passives without <span class=\"italic\">agents </span> (the doers) are common in writing. ", "type": "text"}, {"content": "Look at the chart below for the structure of the passive voice.", "type": "text"}, {"content": "{\"rows\":3,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Name\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Structure\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Present <br/> Continuous\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"am/are/is + being + past participle\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Any director who <span class=\\\"strong\\\">is being supported </span> by a strong production team should realize that they are beyond lucky. </span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Present Perfect\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" have/has + been + past participle\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Today on set the actors <span class=\\\"strong\\\">have been left </span> to me.</span> \\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "When they are being recognized, they are happy and appreciative.", "type": "example"}, {"content": "While this, my new movie, is being made, my team has been thanked daily.", "type": "example"}, {"content": "If they have ever been helped by as many other highly creative people as I have, they should acknowledge that their jobs have been made far easier. ", "type": "example"}, {"content": "Today on set the actors have been left to me.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to support", "type": "name"}, {"content": "to \u200bgive \u200bhelp and encouragement to someone or something ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Any director who is being supported by a strong production team should realize that they are beyond lucky. ", "type": "example"}, {"content": "engenn9le17ob07aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use when talking about a film.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "production team", "type": "name"}, {"content": "the group of technical staff who produce a play, a television show, a recording, or a film", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Any director who is being supported by a strong production team is fortunate.", "type": "example"}, {"content": "engenn9le17ob07aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "beyond lucky", "type": "name"}, {"content": "extremely fortunate", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: That team is beyond lucky. ", "type": "example"}, {"content": "engenn9le17ob07aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to acknowledge", "type": "name"}, {"content": "to \u200baccept, \u200badmit, or \u200brecognize the \u200btruth of something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: They should acknowledge that their jobs have been made far easier.", "type": "example"}, {"content": "engenn9le17ob07aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "appreciative", "type": "name"}, {"content": "being \u200bgrateful for something", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example:  When they are being recognized, they are happy and appreciative.", "type": "example"}, {"content": "engenn9le17ob07aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to overcome", "type": "name"}, {"content": "to \u200b\u200bsucceed in \u200bdealing with something difficult", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I was very confident, and saw every problem as a challenge to be overcome.", "type": "example"}, {"content": "engenn9le17ob07aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "audition", "type": "name"}, {"content": "to try out for a role in a play or film", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I would hold auditions that included both cold readings and improvisations.", "type": "example"}, {"content": "engenn9le17ob07aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "I've never looked back", "type": "name"}, {"content": "to move forward with confidence and without regrets", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example:  I have never looked back.", "type": "example"}, {"content": "engenn9le17ob07aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "rushes", "type": "name"}, {"content": "the raw, unedited footage shot during the making of a movie", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We've watched the rushes daily.", "type": "example"}, {"content": "engenn9le17ob07aud09", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Go online or to the library and look up jobs related to film production.", "type": "text"}, {"content": "Make notes on two different jobs that interest you.", "type": "text"}, {"content": "Use the notes to write a short summary of the job responsibilities.", "type": "text"}, {"content": "Explain why you might enjoy doing that job.", "type": "text"}, {"content": "Read your paragraphs to a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I find out about  jobs related to film production.", "type": "text"}, {"content": "I use my notes to write about two different jobs that interest me.", "type": "text"}, {"content": "I share my written work with a partner and discuss it.", "type": "text"}]}]}