ype": "objective"}], "id": 2}], "_data": [{"type": "instructions", "contents": [{"content": " \nRob would have liked to be an Idoru\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: \n<span class=\"bullet\">Listen to the audio. </span> \n<span class=\"bullet\">Proofread the sentence. </span> \n<span class=\"bullet\">Click on the incorrect word. </span> \n<span class=\"bullet\">Type in the correct word to complete the sentence.</span>\n<span class=\"bullet\">Use capital letters where necessary. </span>", "type": "text"}]}], "id": 8, "stimuli_ids": []}, {"template_override": 1, "type": "SLS", "questions": [{"responses": [{"id": 0, "_data": [{"content": "I might have gone to all her concerts", "type": "text"}], "selected": 0, "correct": true}, {"id": 1, "_data": [{"content": "just to be close to her.", "type": "text"}], "selected": 0, "correct": false}, {"text": "", "id": 2, "_data": [{"content": "I would also have sent her letters", "type": "text"}], "selected": 0, "correct": true}, {"text": "", "id": 3, "_data": [{"content": "to let her know I loved her.", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 4, "_data": [{"content": "The problem is that I didn't have the chance", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 5, "_data": [{"content": "to live those times in Japan.", "type": "text"}], "selected": 0, "correct": 0}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "Peter can't stop thinking about the things he would have done if he met Kyoko.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Read the text and select all the hypotheses about the past.\n", "type": "text"}]}], "id": 9, "stimuli_ids": []}, {"template_override": 1, "type": "RSLT", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn9le17ob06re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " \nCreate your own cyber celebrity!\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self-Assessment.\n", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn9le17ob06re2aud01", "coverimg": "engenn9le17ob06re2img01.jpg", "images": [{"image": "engenn9le17ob06re2img01.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn9le17ob06re2img01.jpg", "text": "You may have heard that soon, your favorite pop stars may not be human. In fact, they may not even be alive. Would you have followed an Idoru, if they had become popular in your culture? Would you have put up a poster of them on your wall? <br /><br />Might you have gone to see them projected as a hologram like Michael Jackson was after his death? Could you have considered marrying an Idoru if they had asked?", "id": 1, "time": "100"}, {"image": "engenn9le17ob06re2img02.jpg", "text": "<br />One of the most popular pop stars Japan has had is Kyoko. She has sung sweet pop songs on the radio to thousands of fans. She liked chocolate ice cream and American hamburgers. She had a boyfriend who played soccer for his high school team. <br /><br />She seemed to be a perfectly normal teenager, except for the fact that she was a computer program. Kyoko's popularity in Japan has decreased over the years. If you had been young in the 90s you may have been part of her fan club. You may have dreamed of meeting her.<br />", "id": 2, "time": "25000"}, {"image": "engenn9le17ob06re2img03.jpg", "text": "<br />The concept of an Idoru has been developed even further by William Gibson in his novel of the same name. You might have read it. In the story a pop star named Rez has claimed to be married to the cyber pop star.<br /><br />If this world had been real, it would have made a great TV series. However, so far it hasn't been possible. That is until the hologram of Michael Jackson popped up. The future looks interesting!", "id": 3, "time": "57000"}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "The World of Entertainment", "type": "lesson_name"}, {"content": "The Future of Rock and Roll", "type": "unit_name"}, {"content": 6, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 17, "type": "lesson"}, {"content": "B2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe situations in spoken interactions according to work and social contexts.", "type": "primary"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_1"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_2"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_3"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_4"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_5"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_6"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_7"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_8"}]}, {"content": "engenn9le17ob06re1img01.jpg", "type": "background_image"}, {"type": "target_word", "contents": [{"content": "alive", "type": "name"}, {"content": "If something is alive, it \u200bcontinues to \u200bexist", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: In fact, they may not even be alive. ", "type": "example"}, {"content": "engenn9le17ob06aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use when talking about technology and music.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "Idoru", "type": "name"}, {"content": "a computer-generated media star, also a character in a science-fiction novel by the same name", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: William Gibson wrote a book called Idoru.", "type": "example"}, {"content": "engenn9le17ob06aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to project", "type": "name"}, {"content": "to cause an image to appear", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Might you have gone to see them projected as a hologram like Michael Jackson was after his death? ", "type": "example"}, {"content": "engenn9le17ob06aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "hologram", "type": "name"}, {"content": "a special kind of picture that is produced by a laser and that looks three-dimensional", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: They cast the image of Michael Jackson as if it were real.", "type": "example"}, {"content": "engenn9le17ob06aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "normal", "type": "name"}, {"content": "\u200bordinary or \u200busual", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: She seemed to be a perfectly normal teenager, except for the fact that she was a computer program. ", "type": "example"}, {"content": "engenn9le17ob06aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to decrease", "type": "name"}, {"content": "to \u200bbecome less, or to make something \u200bbecome less", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Kyoko's popularity in Japan has decreased over the years.", "type": "example"}, {"content": "engenn9le17ob06aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "fan club", "type": "name"}, {"content": "an \u200borganization for \u200bpeople who \u200badmire the same \u200bsinger, \u200bperformer, \u200bfootball \u200bteam, etc.", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example:  If you had been young in the 90s you may have been part of her fan club.", "type": "example"}, {"content": "engenn9le17ob06aud07 ", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to pop up", "type": "name"}, {"content": "to \u200bappear or \u200bhappen, \u200bespecially \u200bsuddenly or \u200bunexpectedly", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: That is until the hologram of Michael Jackson popped up.", "type": "example"}, {"content": "engenn9le17ob06aud08", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Think about creating your own cyber celebrity and what type of person they would be.", "type": "text"}, {"content": "Decide what they would do, what they would look like, what they like, and who they would appeal to.", "type": "text"}, {"content": "Now tell someone about the celebrity using language to speculate in the past. (If you had been in Toronto in 2010, you might have heard about the Idoru there!)", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I create my own cyber celebrity.", "type": "text"}, {"content": "I decide what they would do, what they would look like, what they like, and who they would appeal to.", "type": "text"}, {"content": "I share the information about my celebrity in the past using the modal perfect.", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": " Talking Hypothetically and Speculating About the Past", "type": "heading"}, {"content": "You can use modals to talk about degrees of certainty and speculate about things in the past.<br/> You use them to describe what is definite, probable, possible, or impossible from the speaker's point of view. <br/> You use <span class=\"strong\">could have </span> and <span class=\"strong\">would have </span> to talk about things that were possible in the past and may or may not have happened (speculate).<br/> You often use these structures with the third conditional.", "type": "describer"}, {"content": "You can use <span class=\"italic\">must</span> , <span class=\"italic\">may</span> , <span class=\"italic\">might</span> , and <span class=\"italic\">could</span>  to describe degrees of certainty.<br/> You can use modals with the Present Perfect to talk about the possibility of a past event that is not clear in the present context.", "type": "text"}, {"content": "Example:<br/> <span class=\"italic\">You <span class=\"strong\">may have heard </span> that soon, your favorite pop stars may not be human. </span> <ul><li><span class=\"strong\">May have</span> has a slightly stronger meaning than<span class=\"strong\"> might have </span>or<span class=\"strong\"> could have</span>.</li> <li>You can add <span class=\"strong\">not </span> to make a negative speculation (It <span class=\"strong\">may not have been </span> true).</li> </span> ", "type": "text"}, {"content": "You use <span class=\"strong\">could have </span> to talk about possibilities if something had been different in the past.<br/> For example:<br/> <span class=\"italic\"><span class=\"strong\">Could </span> you <span class=\"strong\">have considered </span> marrying an Idoru if they had asked?  </span> ", "type": "text"}, {"content": "You use <span class=\"strong\">would have </span> to imagine a result if something had been different in the past.<br/> For example: <br/> <span class=\"italic\"><span class=\"strong\">Would </span> you <span class=\"strong\">have put up </span> a poster of them on your wall?</span> ", "type": "text"}, {"content": "Would you have followed an Idoru, if they had become popular in your culture? ", "type": "example"}, {"content": "Would you have put up a poster of them on your wall? ", "type": "example"}, {"content": "Might you have gone to see them projected as a hologram like Michael Jackson was after his death? ", "type": "example"}, {"content": "Could you have considered marrying an Idoru if they had asked?  ", "type": "example"}, {"content": "You may have dreamed of meeting her.", "type": "example"}, {"content": "You might have read it.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " The Present Perfect Tense vs. The Simple Past Tense", "type": "heading"}, {"content": "You use the <span class=\"strong\">Present Perfect tense</span> to talk about a past action or an action that began in the past that is connected to the present in some way. <br/> <br/> You use the <span class=\"strong\">Simple Past tense</span> to talk about many kinds of past events: short, quickly finished actions, longer situations and repeated events. ", "type": "describer"}, {"content": "You can use the <span class=\"strong\">Present Perfect tense </span> to talk about experience.<br/> When you use the <span class=\"strong\"> Present Perfect tense</span>, you think about the past and present together. There is some connection between what happened in the past and now.", "type": "text"}, {"content": "For example: ", "type": "text"}, {"content": "<span class=\"italic\">I <span class=\"strong\">have learned </span> English</span>. = I learned English in the past and now I can speak English.<br/> <span class=\"italic\">One of the most popular pop stars Japan<span class=\"strong\"> has had </span> is Kyoko. </span> ", "type": "text"}, {"content": "Usually, when you use the <span class=\"strong\">Simple Past tense</span> , the time of the finished action is clear from the context or explicitly mentioned in the sentence.", "type": "text"}, {"content": "For example:", "type": "text"}, {"content": "<span class=\"italic\"><span class=\"strong\">Yesterday</span>, I <span class=\"strong\">went </span> to the store.</span> ", "type": "text"}, {"content": "It is clear when the action occurred. In this sentence we would not use the <span class=\"strong\">Present Perfect</span>. (<span class=\"italic\"><strike>Yesterday, I have been to the store</strike></span> ).", "type": "text"}, {"content": "One of the most popular pop stars Japan has had is Kyoko. ", "type": "example"}, {"content": "She has sung sweet pop songs on the radio to thousands of fans.", "type": "example"}, {"content": "She liked chocolate ice cream and American hamburgers. ", "type": "example"}, {"content": "She had a boyfriend who played soccer for his high school team. ", "type": "example"}, {"content": "She seemed to be a perfectly normal teenager, except for the fact that she was a computer program. ", "type": "example"}, {"content": "She gave him a short hug and then stepped back to look at him.", "type": "example"}]}]}